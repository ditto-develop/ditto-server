{
    "family": "ditto-admin-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    },
    "executionRoleArn": "arn:aws:iam::247842832483:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::247842832483:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "ditto-admin",
            "image": "247842832483.dkr.ecr.ap-northeast-2.amazonaws.com/ditto-admin:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8081,
                    "hostPort": 8081,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "prod"
                },
                {
                    "name": "KAKAO_REDIRECT_URI",
                    "value": "https://admin.ditto.pics/oauth/kakao/callback"
                },
                {
                    "name": "KAKAO_CLIENT_ID",
                    "value": "25701116738da897f5e995468dbe54ff"
                }
            ],
            "secrets": [
                {
                    "name": "SPRING_DATASOURCE_URL",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-url"
                },
                {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-username"
                },
                {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-password"
                },
                {
                    "name": "KAKAO_CLIENT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/kakao-oauth-client-secret-q6bSAR"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ditto-admin",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "admin"
                }
            }
        },
        {
            "name": "alloy",
            "image": "247842832483.dkr.ecr.ap-northeast-2.amazonaws.com/ditto-alloy:latest",
            "essential": false,
            "command": [
                "run",
                "/etc/alloy/config.alloy",
                "--server.http.listen-addr=0.0.0.0:12345"
            ],
            "secrets": [
                {
                    "name": "GRAFANA_CLOUD_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-api-key"
                },
                {
                    "name": "GRAFANA_CLOUD_REMOTE_WRITE_URL",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-remote-write-url"
                },
                {
                    "name": "GRAFANA_CLOUD_USERNAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-username"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ditto-admin-alloy",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "alloy"
                }
            }
        }
    ]
}
