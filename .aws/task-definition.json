{
    "family": "ditto-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "512",
    "memory": "1024",
    "runtimePlatform": {
        "cpuArchitecture": "ARM64",
        "operatingSystemFamily": "LINUX"
    },
    "executionRoleArn": "arn:aws:iam::247842832483:role/ecsTaskExecutionRole",
    "taskRoleArn": "arn:aws:iam::247842832483:role/ecsTaskRole",
    "containerDefinitions": [
        {
            "name": "ditto-api",
            "image": "247842832483.dkr.ecr.ap-northeast-2.amazonaws.com/ditto-api:latest",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "hostPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "SPRING_PROFILES_ACTIVE",
                    "value": "prod"
                },
                {
                    "name": "JAVA_TOOL_OPTIONS",
                    "value": "-XX:+UseG1GC -XX:MaxMetaspaceSize=256m"
                },
                {
                    "name": "KAKAO_REDIRECT_URI",
                    "value": "https://api.ditto.pics/api/v1/users/social-login/KAKAO/callback"
                },
                {
                    "name": "KAKAO_ADMIN_REDIRECT_URI",
                    "value": "https://api.ditto.pics/admin/oauth/kakao/callback"
                },
                {
                    "name": "KAKAO_CLIENT_ID",
                    "value": "b632ec5b17a053f898c8969ee24f6735"
                },
                {
                    "name": "APPLE_CLIENT_IDS",
                    "value": "pics.ditto.app,pics.ditto.web"
                },
                {
                    "name": "APPLE_WEB_CLIENT_ID",
                    "value": "pics.ditto.web"
                },
                {
                    "name": "APPLE_WEB_REDIRECT_URI",
                    "value": "https://api.ditto.pics/api/v1/users/social-login/APPLE/callback"
                },
                {
                    "name": "JWT_EXPIRATION_MS",
                    "value": "3600000"
                },
                {
                    "name": "CORS_ALLOWED_ORIGINS",
                    "value": "https://ditto.pics,https://www.ditto.pics"
                },
                {
                    "name": "FRONT_OAUTH_CALLBACK_URL",
                    "value": "https://ditto.pics/auth/callback"
                },
                {
                    "name": "COOKIE_SECURE",
                    "value": "true"
                },
                {
                    "name": "S3_BUCKET",
                    "value": "ditto-storage-247842832483-ap-northeast-2"
                }
            ],
            "secrets": [
                {
                    "name": "API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/api-key"
                },
                {
                    "name": "SPRING_DATASOURCE_URL",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-url"
                },
                {
                    "name": "SPRING_DATASOURCE_USERNAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-username"
                },
                {
                    "name": "SPRING_DATASOURCE_PASSWORD",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/db-password"
                },
                {
                    "name": "KAKAO_CLIENT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/kakao-oauth-client-secret-q6bSAR"
                },
                {
                    "name": "JWT_SECRET",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/jwt-secret-YHkr7t"
                },
                {
                    "name": "FCM_CREDENTIALS",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/fcm-credentials-VPt8UY"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ditto-api",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "api"
                }
            }
        },
        {
            "name": "alloy",
            "image": "247842832483.dkr.ecr.ap-northeast-2.amazonaws.com/ditto-alloy:latest",
            "essential": false,
            "command": [
                "run",
                "/etc/alloy/config.alloy",
                "--server.http.listen-addr=0.0.0.0:12345"
            ],
            "secrets": [
                {
                    "name": "GRAFANA_CLOUD_API_KEY",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-api-key"
                },
                {
                    "name": "GRAFANA_CLOUD_REMOTE_WRITE_URL",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-remote-write-url"
                },
                {
                    "name": "GRAFANA_CLOUD_USERNAME",
                    "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:247842832483:secret:ditto/grafana-cloud-username"
                }
            ],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/ecs/ditto-alloy",
                    "awslogs-region": "ap-northeast-2",
                    "awslogs-stream-prefix": "alloy"
                }
            }
        }
    ]
}
